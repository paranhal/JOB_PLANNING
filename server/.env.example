# 서버 설정
PORT=8080

# DB 설정 (1단계: sqlite, 2단계: postgres)
DB_TYPE=sqlite
DB_PATH=data/app.db

# PostgreSQL 전환 시 아래 주석 해제
# DB_TYPE=postgres
# DB_DSN=postgres://user:password@localhost:5432/customer_support?sslmode=disable

# JWT 시크릿 (운영 시 반드시 변경)
JWT_SECRET=change-this-secret-in-production

# 환경 (development / production)
APP_ENV=development

# 사업관리 초안 메뉴. 비우면 표시. 운영 배포(deploy/docker-compose)만 0.
# SHOW_PROJECTS_SECTOR=1
# 사업관리 설계용 예시 데이터. 운영은 0(빈 화면). 개발은 비우면 표시.
# PROJECT_EXAMPLE_DATA=1

# 한국천문연구원 특일 정보 API (§23.13.2 방법 A)
# Decoding 키를 넣는다 (원문, + 와 == 포함). 코드는 url.Values.Encode() 를 쓴다.
# Encoding 키(%2B…%3D%3D)를 넣어도 한 번만 디코드한다. 소스·docker-compose 에 키를 적지 말 것.
HOLIDAY_API_KEY=

# 영업관리 시스템 연동 API 키 (GET /api/v1/...). 비우면 해당 API 가 503 을 반환한다.
# 소스·Git 에 실제 키를 넣지 말 것.
INTEGRATION_API_KEY=

# 보내는 메일 (Ecount SMTP). 실제 계정·비밀번호는 .env 에만 적는다. Git 금지.
# MAIL_ENABLED=true
# MAIL_HOST=wsmtp.ecount.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM_NAME=비젼아이티 고객지원시스템
# MAIL_ADMIN_TO=

# 관리 섹션 잠금. 키가 비어 있으면 처음 한 번만 넣는다. 10자 이상. Git 에 실제 값 금지.
# VISION_ADMIN_INIT_PASSWORD=
