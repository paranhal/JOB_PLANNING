\f1\b0\fs26 \cf0  1. \uc0\u47785 \u51201  : \u50689 \u50629 \u51032  \u51204 \u44284 \u51221 \u51012  \u44288 \u47532 \u54616 \u44592  \u50948 \u54620  \u49884 \u49828 \u53596 \u50500 \u45796 .\
 2. \uc0\u45236 \u50857  : \
   \uc0\u44032 . \u50689 \u50629 \u51008  \u49324 \u50629 \u50640  \u45824 \u54620  \u51221 \u48372 \u44032  \u51077 \u49688 \u46104 \u45716  \u49884 \u51216  \u48512 \u53552  \u49884 \u51089  \u46120 .\
     - \uc0\u51221 \u48372  \u51077 \u49688  : \u44256 \u44061  \u50836 \u52397 , \u53440 \u49324  \u51221 \u48372  \u51077 \u49688 , \u45817 \u49324  \u45812 \u45817 \u51648  \u51221 \u48372  \u51077 \u49688 , \u50864 \u47532 \u44032  \u52286 \u50500 \u45240  \u44221 \u50864 (\u44256 \u44061  \u49324 \u51060 \u53944 , \u51064 \u53552 \u45367 \u46321 \u51012  \u46244 \u51256 \u49436 ) \u47196  \u44396 \u48516 \
     - \uc0\u50689 \u50629  \u54876 \u46041  : \u51221 \u48372 \u44032  \u51077 \u49688 \u46104 \u47732  \u45796 \u50577 \u54620  \u48169 \u48277 \u51004 \u47196  \u50689 \u50629  \u54876 \u46041 \u51012  \u54616 \u44172  \u46104 \u45712 \u45936 , \u44536 \u51473  \u54620  \u48169 \u48277 \u51060  \u45812 \u45817 \u51088  \u51217 \u52629  \u49884 \u46020 \u51076 . \
                         \uc0\u51204 \u54868 , \u48169 \u47928 \u51012  \u53685 \u54644  \u45812 \u45817 \u51088 \u47484  \u51217 \u52489 \u54616 \u44172  \u46104 \u44256  \u44536  \u51060 \u54980  \u51648 \u49549 \u51201 \u51004 \u47196  \u51217 \u52489 \u51012  \u49884 \u46020 \u54632 .\
                         \uc0\u52572 \u49440 \u51008  \u48169 \u47928 \u54616 \u50668  \u45812 \u45817 \u51088  \u48120 \u54021 \u51012  \u49884 \u46020 \u54616 \u45716 \u45936  \u45812 \u45817 \u51088 \u44032  \u51060 \u47700 \u51068 \u47196  \u51088 \u47308 \u47484  \u48372 \u45236 \u46972 \u44256  \u54616 \u45716  \u44221 \u50864 \u46020  \u51080 \u51020 \
