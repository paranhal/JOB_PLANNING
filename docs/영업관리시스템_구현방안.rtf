                         \uc0\u50689 \u50629  \u45800 \u44228 \u45716  \u48372 \u53685  \
                           \uc0\u51104 \u51116 \u44256 \u44061  \u48156 \u44404  \u8594  \u50689 \u50629 \u44592 \u54924  \u48156 \u44404  \u8594  \u50836 \u44396 \u49324 \u54637  \u54028 \u50501  \u8594  \u51228 \u50504 \'b7\u44204 \u51201  \u8594  \u51077 \u52272 \'b7\u54801 \u49345  \u8594  \u44228 \u50557  \u51064 \u45936 \
