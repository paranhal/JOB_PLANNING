# 업무일지 데이터 (로컬 JSON) — JSON 파일만 저장소에 포함
data/
!data/*.json

# 가상환경
.venv/
.venv-1/

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
dist/
build/

# 서버 환경 설정 (비밀값 포함 가능)
server/.env

# Tailwind 빌드 도구 (생성 CSS는 web/static/vendor/ 에 커밋)
server/node_modules/

# 환경/에디터
.DS_Store
.cursor/
